---
import "../styles/global.css";
import SideNav from "../components/SideNav.astro";
import { ClientRouter } from "astro:transitions";
import TwitterMeta from "../components/meta/TwitterMeta.astro";
import OpenGraphMeta from "../components/meta/OpenGraphMeta.astro";
import PlausibleAnalytics from "../components/meta/PlausibleAnalytics.astro";
import { nav } from "../data/nav.ts";
import SkipLink from "../components/SkipLink.astro";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  publishedTime?: string;
  noindex?: boolean;
  lang?: string;
  structuredData?: string;
};

const {
  title = "William Leemans",
  description = "Salut ! Moi c'est William, architecte logiciel et CTO chez Jetdev à Lille. Je construis des systèmes, mentore des développeurs et crée des produits utiles.",
  ogImage = "/og/default.png",
  ogType = "website",
  publishedTime,
  noindex = false,
  lang = "fr",
  structuredData,
} = Astro.props;

const site = Astro.site?.toString() ?? "https://lmns.fr";
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImageUrl = new URL(ogImage, site).toString();
---

<!doctype html>
<html
  lang={lang}
  class="h-full"
  transition:name="root"
  transition:animate="initial"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="William Leemans"
      href={new URL("rss.xml", Astro.site)}
    />

    <PlausibleAnalytics />

    <!-- Robots -->
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />

    <OpenGraphMeta
      type={ogType}
      publishedTime={publishedTime}
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImageUrl}
    />

    <TwitterMeta title={title} description={description} image={ogImageUrl} />

    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={structuredData}
          is:inline
        />
      )
    }

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      /* Kept in step with the theme by applyTheme() below — the site's theme is
        a class on <html>, not prefers-color-scheme, so a media-query pair here
        would ignore the toggle. */
    }
    <meta name="theme-color" content="#fafafa" />
    <meta name="generator" content={Astro.generator} />

    <ClientRouter />

    <script is:inline>
      // Inlined copy of src/lib/theme-color.ts — this script is `is:inline` so
      // it runs before the first paint, which means it can't import.
      function syncThemeColor() {
        const meta = document.querySelector('meta[name="theme-color"]');
        if (!meta) return;
        const page = getComputedStyle(document.documentElement)
          .getPropertyValue("--color-page")
          .trim();
        if (page) meta.setAttribute("content", page);
      }
      function applyTheme() {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const dark = stored === "dark" || (!stored && prefersDark);
        document.documentElement.classList.toggle("dark", dark);
        syncThemeColor();
      }
      applyTheme();
      // The stylesheet may not have parsed yet on the first run, in which case
      // --color-page reads empty and the bar keeps its server-rendered value.
      document.addEventListener("DOMContentLoaded", syncThemeColor);
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
  </head>
  <body class="dark:text-primary-100 h-full min-h-screen antialiased">
    <!--
      THESIS: The type is a score, not a UI kit. It refuses the arrangement
      every engineer's site ships — a display grotesk shouting over a
      monospace body — because a mono body is why long articles here were
      hard to read.
      OWN-WORLD: Two families, three registers. Alegreya roman is the voice
      (headings and prose), Alegreya italic is the expression register
      (captions, notes, annotations), Azeret Mono is notation and
      measurement only (code, dates, figures). Charcoal on paper, one brass
      wire, hairlines and registration ticks unchanged.
      STORY: The reader opens a long French article and stays inside it;
      annotations read as expression marks, never as UI labels.
      FIRST VIEWPORT: h1 in Alegreya 700 at reading scale, not display
      scale; the rail reads as a score's margin of instrument names in
      tracked roman caps; dates and reading times in mono figures.
      FORM: La partition — the graphic score. Candidate 6 of 6, seed
      add0ec51.
      FINISH: unreviewed and undocumented is unfinished; this build ends
      with the finish review, the verdict, and DESIGN.md
    -->
    <SkipLink />

    <!-- Dot grid background -->
    <div class="blog-dot-grid" aria-hidden="true"></div>

    <!-- Content area -->
    <div class="flex min-h-screen">
      <SideNav items={nav} />

      <main id="contenu" tabindex="-1" class="w-full md:ml-16">
        <div class="h-14 md:h-0"></div>
        <div
          class="relative mx-auto max-w-4xl px-4 py-8 sm:px-6 md:px-10 md:py-12 lg:py-16"
        >
          <slot />
        </div>
      </main>
    </div>

    <script>
      import "../scripts/circuit";
      import "../scripts/respire";
    </script>
  </body>
</html>

<style>
  /* Dot grid — full-page fixed layer */
  .blog-dot-grid {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle,
      rgba(107, 107, 107, 0.13) 1px,
      transparent 1px
    );
    background-size: 20px 20px;
  }

  :global(.dark) .blog-dot-grid {
    background-image: radial-gradient(
      circle,
      rgba(250, 250, 250, 0.06) 1px,
      transparent 1px
    );
  }
</style>
