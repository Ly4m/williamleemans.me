---
import BlogLayout from "../layouts/BlogLayout.astro";
import HomeDecoration from "../components/HomeDecoration.astro";
import HomeMarginDecoration from "../components/HomeMarginDecoration.astro";
import HomeFooterDecoration from "../components/HomeFooterDecoration.astro";

const site = Astro.site?.toString() ?? "https://lmns.fr";

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: "William Leemans",
    url: site,
    jobTitle: "Architecte logiciel & CTO",
    worksFor: {
      "@type": "Organization",
      name: "Jetdev",
      url: "https://www.jetdev.fr",
    },
    sameAs: ["https://github.com/Ly4m", "https://www.linkedin.com/in/wleemans"],
    workLocation: {
      "@type": "Place",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Lille",
        addressCountry: "FR",
      },
    },
  },
});
---

<BlogLayout
  title="William Leemans — Architecte logiciel à Lille"
  ogImage="/og/default.png"
  structuredData={structuredData}
>
  <div class="py-8 md:py-12">
    <header class="mb-6 md:mb-8">
      <h1
        class="font-space text-charcoal dark:text-primary-100 text-2xl tracking-tight md:text-3xl"
      >
        William Leemans
      </h1>
      {
        /* Les deux espaces insécables tiennent le tiret par ses deux bouts :
           sans celle de gauche, la ligne casse avant lui et le mobile ouvre sa
           deuxième ligne sur « — Lille ». Délibéré — ne pas « nettoyer ». */
      }
      <p class="text-faded mt-2 text-sm">
        architecte logiciel &amp; CTO chez Jetdev&nbsp;—&nbsp;Lille
      </p>
      <HomeDecoration />
    </header>

    <div class="flex items-start gap-4">
      <section
        class="text-charcoal dark:text-primary-100 prose dark:prose-invert wave-enter-content min-w-0"
      >
        <p>Italo-belge, entrepreneur, passionné de systèmes et de code.</p>
        {
          /* « cofondé » au masculin : Jetdev est pensé comme un nom de marque
            (genre par défaut), pas comme « la société Jetdev ». Décision
            délibérée, pas un accord oublié — ne pas « corriger ». */
        }
        <p>
          Avec <a
            target="_blank"
            rel="noopener noreferrer"
            class="orange"
            href="https://www.jetdev.fr"
            >Jetdev<span class="sr-only"> (nouvelle fenêtre)</span></a
          >, que j'ai cofondé, je conçois des systèmes pour des clients comme
          Kiabi, Exotec ou Decathlon, et je donne vie à nos propres produits,
          <a
            rel="noopener noreferrer"
            target="_blank"
            class="pink"
            href="https://www.scanzee.app/"
            >Scanzee<span class="sr-only"> (nouvelle fenêtre)</span></a
          >
          et Distract.
        </p>
        <p>
          J'adore apprendre, puis partager, autour d'un café, <a
            class="mine"
            href="/talks">d'un talk</a
          > ou simplement sur internet : <a class="mine" href="/blog"
            >j'écris ici</a
          >
          sur ce que je construis, ce que je casse, et ce que ça m'apprend.
        </p>
        <p>
          Quand je ne code pas, on peut souvent me trouver en train d'affronter
          un boss manette en main, le nez plongé dans une BD, ou en train de
          tester une nouvelle recette avec ma femme. Le reste, lectures, jeux,
          projets, tient sur ma page <a class="mine" href="/now">Now</a>.
        </p>
        <nav aria-label="Contact et réseaux" class="not-prose mt-8">
          <p class="invite mb-3">Envie de dire bonjour ou de discuter tech ?</p>
          <ul class="space-y-0 md:space-y-1.5">
            <li>
              <a
                href="mailto:william@lmns.fr"
                class="row mine flex items-center gap-3 py-2.5 md:py-0"
              >
                <span
                  class="icon-[tabler--mail] shrink-0 text-lg"
                  aria-hidden="true"></span>
                <span class="w-24 shrink-0"
                  ><span class="label">M'écrire</span></span
                >
                <span class="text-faded text-sm">william@lmns.fr</span>
              </a>
            </li>
            <li>
              <a
                target="_blank"
                href="https://github.com/Ly4m"
                rel="me noopener noreferrer"
                class="row flex items-center gap-3 py-2.5 md:py-0"
              >
                <span
                  class="icon-[tabler--brand-github] shrink-0 text-lg"
                  aria-hidden="true"></span>
                <span class="w-24 shrink-0"
                  ><span class="label">GitHub</span></span
                >
                <span class="text-faded text-sm">@Ly4m</span>
                <span class="sr-only">(nouvelle fenêtre)</span>
              </a>
            </li>
            <li>
              <a
                target="_blank"
                href="https://www.linkedin.com/in/wleemans"
                rel="me noopener noreferrer"
                class="row flex items-center gap-3 py-2.5 md:py-0"
              >
                <span
                  class="icon-[tabler--brand-linkedin] shrink-0 text-lg"
                  aria-hidden="true"></span>
                <span class="w-24 shrink-0"
                  ><span class="label">LinkedIn</span></span
                >
                <span class="text-faded text-sm">wleemans</span>
                <span class="sr-only">(nouvelle fenêtre)</span>
              </a>
            </li>
          </ul>
        </nav>
      </section>
      <HomeMarginDecoration />
    </div>

    <HomeFooterDecoration />
  </div>
</BlogLayout>

<style>
  a {
    font-weight: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(125, 125, 125, 0.3);
    transition: border 0.3s ease-in-out;

    &:hover {
      border-bottom: 1px solid var(--color-charcoal);
    }
  }

  :global(.dark) a:hover {
    border-bottom-color: var(--color-primary-100);
  }

  /* Outbound links wear their brand colour; my own surfaces wear brass. Brass
     stays on the line, never on the text, and needs the darker ink on #fafafa —
     and the brand hues obey the same constraint: a state line must reach 3:1
     there. Scanzee's pink clears it as-is (4.0:1); Jetdev's orange manages only
     2.5:1, so light mode wears the nearest same-hue orange that passes
     (#fe5a00, 3.0:1) while dark mode keeps the true brand. */
  a.orange:hover {
    border-bottom-color: #fe5a00;
  }

  a.pink:hover {
    border-bottom-color: #e82483;
  }

  :global(.dark) a.orange:hover {
    border-bottom-color: #ff772c;
  }

  :global(.dark) a.pink:hover {
    border-bottom-color: #e82483;
  }

  a.mine:hover {
    border-bottom-color: var(--color-brass-ink);
  }

  :global(.dark) a.mine:hover {
    border-bottom-color: var(--color-brass);
  }

  /* The page's one address to the visitor carries the site's one wire: the
     figcaption tick promoted to the invitation — brass on a line, never on
     the text. Decided 2026-08-10 over keeping home brass-silent. */
  .invite {
    border-left: 1px solid var(--color-brass-ink);
    padding-left: 0.6rem;
  }

  :global(.dark) .invite {
    border-left-color: var(--color-brass);
  }

  /* Contact rows: the whole row is the target, but only the label carries the rule. */
  a.row {
    border-bottom: none;
  }

  a.row .label {
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease-in-out;
  }

  a.row:hover .label {
    border-bottom-color: var(--color-charcoal);
  }

  a.row.mine:hover .label {
    border-bottom-color: var(--color-brass-ink);
  }

  :global(.dark) a.row:hover .label {
    border-bottom-color: var(--color-primary-100);
  }

  :global(.dark) a.row.mine:hover .label {
    border-bottom-color: var(--color-brass);
  }

  @media (prefers-reduced-motion: reduce) {
    a,
    a.row .label {
      transition: none;
    }
  }
</style>
