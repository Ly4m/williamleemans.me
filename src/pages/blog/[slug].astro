---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import BlogPostDecoration from "../../components/BlogPostDecoration.astro";
import ArticleSignoff from "../../components/ArticleSignoff.astro";
import ReadNext from "../../components/ReadNext.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  const readNextFor = (post: CollectionEntry<"blog">) => {
    if (post.data.related?.length) {
      return post.data.related.map((slug: string) => {
        const target = posts.find((p) => p.data.slug === slug);
        if (!target) {
          throw new Error(`Unknown related slug "${slug}" in "${post.id}"`);
        }
        return target;
      });
    }
    return posts
      .filter((p) => p.data.slug !== post.data.slug)
      .sort(
        (a, b) =>
          Math.abs(a.data.pubDate.getTime() - post.data.pubDate.getTime()) -
          Math.abs(b.data.pubDate.getTime() - post.data.pubDate.getTime()),
      )
      .slice(0, 2);
  };

  return posts.map((post: CollectionEntry<"blog">) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      readNext: readNextFor(post).map((p) => ({
        slug: p.data.slug,
        title: p.data.title,
        pubDate: p.data.pubDate,
      })),
    },
  }));
}

const { post, readNext } = Astro.props;
const { Content } = await render(post);

/**
 * UTC rather than the build machine's zone: `pubDate` is coerced from a bare
 * `YYYY-MM-DD`, so it lands on UTC midnight and would slip a day anywhere west.
 */
const fmtMeta = (date: Date) =>
  new Intl.DateTimeFormat("fr-FR", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);

/** UTC pour la même raison que `fmtMeta` : les getters locaux reculent d'un
 * mois sur une date du 1er, dans toute zone à l'ouest de UTC. */
const fmtDate = (date: Date) => {
  const y = date.getUTCFullYear();
  const m = (date.getUTCMonth() + 1).toString().padStart(2, "0");
  return `${y}·${m}`;
};

const readingTime = `T:${String(post.data.readingTime).padStart(2, "0")}`;
const dateLabel = fmtDate(post.data.pubDate);

const site = Astro.site?.toString() ?? "https://lmns.fr";
/** Slash final obligatoire : le `<link rel="canonical">` des layouts le porte
 * (il vient de `Astro.url.pathname`), et le sitemap aussi. Sans lui, le JSON-LD
 * désigne une URL qui redirige, donc une autre URL que la canonique. */
const postUrl = new URL(`/blog/${post.data.slug}/`, site).toString();

const graph: object[] = [
  {
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.dateModified ?? post.data.pubDate).toISOString(),
    inLanguage: "fr",
    mainEntityOfPage: postUrl,
    url: postUrl,
    author: {
      "@type": "Person",
      name: "William Leemans",
      url: site,
    },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: site },
      {
        "@type": "ListItem",
        position: 2,
        name: "Blog",
        item: new URL("/blog/", site).toString(),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: post.data.title,
        item: postUrl,
      },
    ],
  },
];

if (post.data.howTo) {
  graph.push({
    "@type": "HowTo",
    name: post.data.howTo.name,
    inLanguage: "fr",
    mainEntityOfPage: postUrl,
    step: post.data.howTo.steps.map((step, index) => ({
      "@type": "HowToStep",
      position: index + 1,
      name: step.name,
      text: step.text,
    })),
  });
}

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
});
---

<BlogLayout
  title={post.data.title + " — William Leemans"}
  description={post.data.description}
  ogImage={post.data.ogImage ?? `/blog/og/${post.data.slug}.png`}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
  structuredData={structuredData}
>
  <div id="reading-progress" aria-hidden="true"></div>

  {
    /*
    `article-measure` puts every block on the article's own column — title,
    prose, sign-off and "À lire ensuite" all resolve `55ch` against the prose
    size rather than their own, so the page keeps one left and right edge from
    the title to the last row.

    The <header> lives INSIDE the <article>: it carries the h1 and the date,
    and outside it a reader who jumps to the article landed in an article with
    no heading and no date in it.

    `relative` sert au sommaire, qui se raccroche à cette enveloppe pour aller
    se poser dans la marge droite. La classe est posée ICI et pas sur
    `.article-measure` : le primitif est global et ne décrit qu'une colonne de
    texte — lui donner un contexte de positionnement pour un seul consommateur
    en ferait un conteneur de mise en page, ce qu'il n'est pas.
  */
  }
  <div
    class="text-charcoal dark:text-primary-100 article-measure relative mb-16"
  >
    {
      /*
      LES DEUX BUS. Deux traits, rien de plus : le dessin vit dans
      `global.css` (`.article-bus`), les abonnés le rejoignent depuis leur
      propre boîte, et un `:has()` les efface tous les deux sur un article où
      rien ne se branche. Ils sont `aria-hidden` et hors du flux — un lecteur
      d'écran n'a pas de décor à annoncer.

      Celui de droite est NU de points : il ne porte que la branche du
      sommaire. Lui donner les mêmes jonctions que celui de gauche ferait deux
      fois la même liste, une fois en fil et une fois en mots.
    */
    }
    <div class="article-bus article-bus-gauche" aria-hidden="true"></div>
    <div class="article-bus article-bus-droite" aria-hidden="true"></div>

    <article>
      <header class="py-12">
        <h1
          class="font-voice text-charcoal dark:text-primary-100 text-3xl md:text-4xl"
        >
          {post.data.title}
        </h1>
        <p class="text-faded register-notation text-sm">
          {post.data.readingTime} min — <time
            datetime={post.data.pubDate.toISOString().slice(0, 10)}
            >{fmtMeta(post.data.pubDate)}</time
          >
        </p>
        <BlogPostDecoration readingTime={readingTime} dateLabel={dateLabel} />
      </header>

      <div class="prose prose-longform dark:prose-invert wave-enter-content">
        <Content />
      </div>
    </article>
    <ArticleSignoff
      pubDate={post.data.pubDate}
      dateModified={post.data.dateModified}
    />
    {readNext.length > 0 && <ReadNext posts={readNext} />}
  </div>
</BlogLayout>

<script>
  import "../../scripts/blog-post";
</script>
