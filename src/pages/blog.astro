---
import BlogLayout from "../layouts/BlogLayout.astro";
import BlogListDecoration from "../components/BlogListDecoration.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// The year is carried by the group heading, so the row only needs the month.
const fmtMonth = (date: Date) =>
  (date.getUTCMonth() + 1).toString().padStart(2, "0");

// `datetime` has to stand alone, so it carries the year the row leaves implicit.
const isoMonth = (date: Date) => `${date.getUTCFullYear()}-${fmtMonth(date)}`;

const groups = posts.reduce(
  (
    acc: { year: number; posts: CollectionEntry<"blog">[] }[],
    post: CollectionEntry<"blog">,
  ) => {
    const year = post.data.pubDate.getUTCFullYear();
    const last = acc[acc.length - 1];
    if (last && last.year === year) last.posts.push(post);
    else acc.push({ year, posts: [post] });
    return acc;
  },
  [],
);

const postCount = `N:${String(posts.length).padStart(2, "0")}`;
const newestYear = posts[0].data.pubDate.getUTCFullYear();
const oldestYear = posts[posts.length - 1].data.pubDate.getUTCFullYear();
const yearSpan =
  newestYear === oldestYear
    ? String(newestYear)
    : `${oldestYear}–${newestYear}`;
---

<BlogLayout
  title="Le blog — William Leemans"
  description="Articles de William Leemans sur l'architecture logicielle, les systèmes distribués, le développement et son setup."
>
  <div class="max-w-2xl">
    <header class="py-12">
      <h1
        class="font-space text-charcoal dark:text-primary-100 text-2xl tracking-tight md:text-3xl"
      >
        Le blog
      </h1>
      <BlogListDecoration postCount={postCount} yearSpan={yearSpan} />
    </header>

    <div class="text-ash">
      {
        groups.map(({ year, posts: yearPosts }) => (
          <section class="mb-8 last:mb-0">
            <h2 class="text-faded font-space mb-2 text-sm tabular-nums">
              {year}
            </h2>
            <ul>
              {yearPosts.map((post: CollectionEntry<"blog">) => (
                <li>
                  <a
                    href={`/blog/${post.data.slug}`}
                    class="group flex items-center justify-between gap-1 py-0.5"
                  >
                    <time
                      datetime={isoMonth(post.data.pubDate)}
                      class="text-faded group-hover:text-charcoal dark:group-hover:text-primary-100 text-sm tabular-nums transition-colors group-hover:transition-none motion-reduce:transition-none"
                    >
                      {fmtMonth(post.data.pubDate)}
                    </time>
                    <span
                      aria-hidden="true"
                      class="text-faded dot-leader grow leading-none transition-colors group-hover:transition-none motion-reduce:transition-none"
                    />
                    <span class="group-hover:text-charcoal dark:group-hover:text-primary-100 text-faded">
                      {post.data.title}
                    </span>
                    <span class="text-faded ml-3 w-12 shrink-0 text-right text-sm tabular-nums">
                      {post.data.readingTime} min
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</BlogLayout>
