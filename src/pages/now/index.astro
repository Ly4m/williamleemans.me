---
import Layout from "../../layouts/Layout.astro";
import NowEntry from "../../components/NowEntry.astro";
import NowDecoration from "../../components/NowDecoration.astro";
import { getCollection } from "astro:content";

const nowEntries = await getCollection("now");
const sortedEntries = nowEntries.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const latestEntry = sortedEntries[0];
const previousEntries = sortedEntries.slice(1);
---

<Layout
  title="Maintenant — William Leemans"
  description="Ce qu'il se passe dans la vie de William Leemans en ce moment : lectures, jeux, projets et envies du moment."
  ogImage="/og/default.png"
>
  <div class="max-w-2xl">
    <header class="py-8 md:py-12">
      <h1
        class="font-voice text-charcoal dark:text-primary-100 text-3xl md:text-4xl"
      >
        Now
      </h1>
      <NowDecoration />
    </header>
    <div class="text-charcoal dark:text-primary-100 max-w-2xl">
      <p class="mb-8">
        Ce qu'il se passe dans ma vie en ce moment, inspiré par <a
          target="_blank"
          referrerpolicy="no-referrer"
          href="https://nownownow.com/about">nownownow.com</a
        >
      </p>

      {latestEntry && <NowEntry entry={latestEntry} />}

      {
        previousEntries.length > 0 && (
          <section class="mt-12 mb-40">
            <h2 class="font-voice mb-4 text-xl">Précédentes entrées</h2>
            <ul class="space-y-2">
              {previousEntries.map((entry) => (
                <li>
                  <a
                    href={`/now/${entry.id}`}
                    class="text-charcoal dark:text-primary-100 hover:underline"
                  >
                    {entry.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </div>
</Layout>

<style>
  h2 {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  p + p {
    margin-top: 1rem;
  }

  a {
    text-decoration: underline;
  }
</style>
