---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import NowEntry from "../../components/NowEntry.astro";
import NowDecoration from "../../components/NowDecoration.astro";

export async function getStaticPaths() {
  const posts = await getCollection("now");
  return posts.map((post: CollectionEntry<"now">) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<Layout
  title={post.data.title + " — William Leemans"}
  description={`Ce que faisait William Leemans en ${post.data.title.toLowerCase()} : projets, travail, lectures et jeux vidéo. Archive de sa page Now.`}
  ogImage="/og/default.png"
>
  <header class="py-8 md:py-12">
    <h1
      class="font-voice text-charcoal dark:text-primary-100 text-3xl md:text-4xl"
    >
      {post.data.title}
    </h1>
    <NowDecoration />
  </header>
  <div class="text-charcoal dark:text-primary-100 mb-40">
    <p class="mb-8">
      Ce qu'il se passe dans ma vie en ce moment, inspiré par <a
        target="_blank"
        referrerpolicy="no-referrer"
        href="https://nownownow.com/about">nownownow.com</a
      >
    </p>
    <NowEntry entry={post} />
  </div>
</Layout>
