---
type Props = {
  talkCount: string;
  yearSpan: string;
};

const { talkCount, yearSpan } = Astro.props;
---

<!--
  Grid-aligned circuit decoration for the talks page header.
  Same 20px grid as the other decorations, so it rhymes with the dot grid.

  The motif is a raised plateau — the trace steps up, runs level, steps back
  down. A stage, without drawing one.

  y=40  ──|──────╭────────────╮────────────|──────────|────
                 │            │
  y=20           ╰─ plateau ──╯
-->
<div class="mt-5 hidden md:block" aria-hidden="true">
  <svg
    width="380"
    height="60"
    viewBox="0 0 380 60"
    fill="none"
    class="decoration"
  >
    <!-- Tick at x=20 -->
    <path
      d="M 20 36 L 20 44"
      stroke="currentColor"
      stroke-width="0.75"
      class="circuit-trace"></path>

    <!-- Left segment: start → foot of the rise -->
    <path
      d="M 0 40 L 80 40"
      stroke="currentColor"
      stroke-width="1"
      class="circuit-trace"></path>

    <!-- The plateau: up at x=80, level to x=160, back down -->
    <path
      d="M 80 40 L 80 20"
      stroke="currentColor"
      stroke-width="1"
      class="circuit-trace"></path>
    <path
      d="M 80 20 L 160 20"
      stroke="currentColor"
      stroke-width="1"
      class="circuit-trace"></path>
    <path
      d="M 160 20 L 160 40"
      stroke="currentColor"
      stroke-width="1"
      class="circuit-trace"></path>

    <!-- Right segment: foot of the fall → end -->
    <path
      d="M 160 40 L 380 40"
      stroke="currentColor"
      stroke-width="1"
      class="circuit-trace"></path>

    <!-- Ticks at x=240 and x=340 -->
    <path
      d="M 240 36 L 240 44"
      stroke="currentColor"
      stroke-width="0.75"
      class="circuit-trace"></path>
    <path
      d="M 340 36 L 340 44"
      stroke="currentColor"
      stroke-width="0.75"
      class="circuit-trace"></path>

    <!-- Junction dots at the feet, smaller ones at the corners -->
    <circle cx="80" cy="40" r="2" fill="currentColor" class="circuit-dot"
    ></circle>
    <circle cx="160" cy="40" r="2" fill="currentColor" class="circuit-dot"
    ></circle>
    <circle cx="80" cy="20" r="1.5" fill="currentColor" class="circuit-dot"
    ></circle>
    <circle cx="160" cy="20" r="1.5" fill="currentColor" class="circuit-dot"
    ></circle>

    <!-- Labels: talk count (left) and year span (right of the plateau) -->
    <text
      x="0"
      y="57"
      font-family="'IBM Plex Mono', monospace"
      font-size="8"
      letter-spacing="0.08em"
      fill="currentColor"
      class="circuit-label">{talkCount}</text
    >
    <text
      x="200"
      y="57"
      font-family="'IBM Plex Mono', monospace"
      font-size="8"
      letter-spacing="0.08em"
      fill="currentColor"
      class="circuit-label">{yearSpan}</text
    >
  </svg>
</div>

<style>
  .decoration {
    color: var(--ink-circuit);
  }

  .circuit-dot,
  .circuit-label {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .circuit-dot,
    .circuit-label {
      opacity: 1 !important;
      animation: none !important;
    }
  }
</style>
