---
// No props — purely visual footer decoration for the home page.
---

<!--
  Full-width closing trace.
  A single arc at the center echoes the header's motif — same geometry,
  same orientation — as a quiet callback to the opening decoration.
  Four ticks are placed symmetrically around the arc center (x=370).

  y=0   ────────────────────────────●────────────────────────────
                                 apex(370)
  y=20  ──|─────────|──────────╮─────────╰──────────|─────────|──
         tick(60) tick(220)  arc(350→390)          tick(520) tick(680)
-->
<div class="mt-6 hidden overflow-visible md:block" aria-hidden="true">
  <svg
    width="100%"
    viewBox="0 -6 760 36"
    fill="none"
    class="decoration"
    style="overflow: visible"
  >
    <!-- Trace: full width -->
    <path
      d="M 0 20 L 350 20"
      stroke="currentColor"
      stroke-width="1"
      class="circuit-trace"></path>
    <path
      d="M 390 20 L 760 20"
      stroke="currentColor"
      stroke-width="1"
      class="circuit-trace"></path>

    <!-- Center arc — same r=20 semicircle as the header arcs, same upward orientation -->
    <path
      d="M 350 20 A 20 20 0 0 1 390 20"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      class="circuit-trace"></path>

    <!-- Ticks placed symmetrically around arc center (x=370) -->
    <path
      d="M 60  16 L 60  24"
      stroke="currentColor"
      stroke-width="0.75"
      class="circuit-trace"></path>
    <path
      d="M 220 16 L 220 24"
      stroke="currentColor"
      stroke-width="0.75"
      class="circuit-trace"></path>
    <path
      d="M 520 16 L 520 24"
      stroke="currentColor"
      stroke-width="0.75"
      class="circuit-trace"></path>
    <path
      d="M 680 16 L 680 24"
      stroke="currentColor"
      stroke-width="0.75"
      class="circuit-trace"></path>

    <!-- Arc apex dot -->
    <circle cx="370" cy="0" r="1.5" fill="currentColor" class="circuit-dot"
    ></circle>

    <!-- Arc endpoint junction dots -->
    <circle cx="350" cy="20" r="2" fill="currentColor" class="circuit-dot"
    ></circle>
    <circle cx="390" cy="20" r="2" fill="currentColor" class="circuit-dot"
    ></circle>
  </svg>
</div>

<style>
  .decoration {
    color: rgba(107, 107, 107, 0.65);
  }

  :global(.dark) .decoration {
    color: color-mix(in srgb, var(--color-brass) 28%, transparent);
  }

  .circuit-dot {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .circuit-dot {
      opacity: 1 !important;
      animation: none !important;
    }
  }
</style>
