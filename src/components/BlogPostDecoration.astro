---
type Props = {
  readingTime: string;
  dateLabel: string;
};

const { readingTime, dateLabel } = Astro.props;
---

<!--
  Grid-aligned circuit decoration for the blog post page header.
  Smaller/subtler variant of the list decoration.

  y=40  ──|──────●══╮══●──────●────────────────|────────────
           tick arc-L  arc-R branch           tick
  y=20             apex   branch-top
-->
<div class="mt-4 hidden md:block" aria-hidden="true">
  <svg
    width="260"
    height="60"
    viewBox="0 0 260 60"
    fill="none"
    class="decoration"
  >
    <!-- Tick at x=20 -->
    <path
      d="M 20 36 L 20 44"
      stroke="currentColor"
      stroke-width="0.75"
      class="circuit-trace"></path>

    <!-- Left segment: start → arc -->
    <path
      d="M 0 40 L 40 40"
      stroke="currentColor"
      stroke-width="1"
      class="circuit-trace"></path>

    <!-- Arc dome: x=40→x=80, center (60,40), radius 20, apex at (60,20) -->
    <path
      d="M 40 40 A 20 20 0 0 1 80 40"
      stroke="currentColor"
      stroke-width="1"
      class="circuit-trace"></path>

    <!-- Middle segment: arc → branch -->
    <path
      d="M 80 40 L 120 40"
      stroke="currentColor"
      stroke-width="1"
      class="circuit-trace"></path>

    <!-- Branch at x=120: up to y=20 -->
    <path
      d="M 120 40 L 120 20"
      stroke="currentColor"
      stroke-width="1"
      class="circuit-trace"></path>

    <!-- Right segment: branch → end -->
    <path
      d="M 120 40 L 260 40"
      stroke="currentColor"
      stroke-width="1"
      class="circuit-trace"></path>

    <!-- Tick at x=200 -->
    <path
      d="M 200 36 L 200 44"
      stroke="currentColor"
      stroke-width="0.75"
      class="circuit-trace"></path>

    <!-- Arc junction dots -->
    <circle cx="40" cy="40" r="1.75" fill="currentColor" class="circuit-dot"
    ></circle>
    <circle cx="80" cy="40" r="1.75" fill="currentColor" class="circuit-dot"
    ></circle>
    <!-- Apex dot -->
    <circle cx="60" cy="20" r="1.25" fill="currentColor" class="circuit-dot"
    ></circle>
    <!-- Branch junction dot -->
    <circle cx="120" cy="40" r="1.75" fill="currentColor" class="circuit-dot"
    ></circle>
    <!-- Branch top dot -->
    <circle cx="120" cy="20" r="1.25" fill="currentColor" class="circuit-dot"
    ></circle>

    <!-- Labels: reading time (left) and post date (right of branch) -->
    <text
      x="0"
      y="57"
      font-family="'IBM Plex Mono', monospace"
      font-size="8"
      letter-spacing="0.08em"
      fill="currentColor"
      class="circuit-label">{readingTime}</text
    >
    <text
      x="140"
      y="57"
      font-family="'IBM Plex Mono', monospace"
      font-size="8"
      letter-spacing="0.08em"
      fill="currentColor"
      class="circuit-label">{dateLabel}</text
    >
  </svg>
</div>

<style>
  .decoration {
    color: var(--ink-circuit);
  }

  .circuit-dot,
  .circuit-label {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .circuit-dot,
    .circuit-label {
      opacity: 1 !important;
      animation: none !important;
    }
  }
</style>
