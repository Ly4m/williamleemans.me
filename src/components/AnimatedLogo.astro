---
/* Sur la home, le h1 juste sous la barre dit déjà « William Leemans » — le
   cycle du logo empilait le nom deux fois. Épinglé sur les initiales là, et
   là seulement ; le survol déplie toujours, c'est le geste du visiteur. */
const onHome = Astro.url.pathname === "/";
---

<a href="/" class:list={["logo", onHome && "logo-pinned"]}>
  <span class="logo-initials">W</span>
  <span class="logo-full">illiam</span>
  <span class="logo-initials">&nbsp;L</span>
  <span class="logo-full">eemans</span>
</a>

<style>
  .logo {
    font-weight: 600;
    letter-spacing: 0.08em;
    white-space: nowrap;
    overflow: hidden;
    cursor: pointer;
    position: relative;
    align-items: center;
    display: inline-flex;
  }

  .logo-part {
    display: flex;
  }

  .logo-initials {
    position: relative;
  }

  .logo-full {
    display: inline-block;
    overflow: hidden;
    max-width: 0;
    opacity: 0;
    filter: blur(4px);
    color: var(--color-faded, #888);
    animation: name-expand 20s ease-in-out infinite;
  }

  .logo-full:first-of-type {
    animation-delay: 0.1s;
  }
  .logo-full:last-of-type {
    animation-delay: 0.35s;
  }

  .logo:hover .logo-full {
    max-width: 16ch;
    opacity: 1;
    filter: blur(0);
    color: var(--color-faded);
    animation-play-state: paused;
  }

  /* Sous reduced-motion, le cycle s'arrête, figé sur l'état replié — les
     initiales seules, l'état dominant du composant. Le survol continue de
     déplier le nom : c'est un geste de l'utilisateur, et la règle de base
     pose déjà l'état replié en statique ; sans transition, la révélation
     est simplement instantanée. */
  @media (prefers-reduced-motion: reduce) {
    .logo-full {
      animation: none;
    }
  }

  .logo-pinned .logo-full {
    animation: none;
  }

  @keyframes name-expand {
    0%,
    20% {
      max-width: 0;
      opacity: 0;
      filter: blur(4px);
    }

    25%,
    55% {
      max-width: 18ch;
      opacity: 1;
      filter: blur(0);
    }

    60%,
    100% {
      max-width: 0;
      opacity: 0;
      filter: blur(3px);
    }
  }
</style>
