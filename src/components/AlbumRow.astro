---
interface Props {
  index: number;
  title: string;
  artist: string;
  note?: string;
  url: string;
  statusLabel: string;
  tone: "accent" | "neutral";
}

const { index, title, artist, note, url, statusLabel, tone } = Astro.props;
const num = String(index + 1).padStart(2, "0");
---

<li class="row">
  <span class="row-index" aria-hidden="true">{num}</span>
  <div class="row-main">
    <a class="row-title" href={url} target="_blank" rel="noopener noreferrer">
      {title}<span class="row-arrow" aria-hidden="true">↗</span>
    </a>
    <p class="row-artist">{artist}</p>
    {note && <p class="row-note">{note}</p>}
  </div>
  <span
    class:list={["badge", tone === "accent" ? "badge-accent" : "badge-neutral"]}
  >
    {statusLabel}
  </span>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0 0.85rem;
    align-items: start;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(37, 37, 37, 0.12);
  }

  :global(.dark) .row {
    border-bottom-color: rgba(250, 250, 250, 0.1);
  }

  .row-index {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    color: var(--color-faded);
    padding-top: 0.15rem;
  }

  .row-title {
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-charcoal);
    text-decoration: none;
  }

  :global(.dark) .row-title {
    color: var(--color-primary-100);
  }

  .row-title:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .row-arrow {
    font-size: 0.7rem;
    color: var(--color-faded);
    margin-left: 0.3rem;
  }

  .row-artist,
  .row-note {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    color: #555;
    line-height: 1.5;
    margin: 0;
  }

  .row-artist {
    margin-top: 0.15rem;
  }

  .row-note {
    margin-top: 0.3rem;
  }

  :global(.dark) .row-artist,
  :global(.dark) .row-note {
    color: #aaa;
  }

  .badge {
    display: inline-block;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
    width: fit-content;
    white-space: nowrap;
    text-transform: uppercase;
    margin-top: 0.15rem;
  }

  .badge-neutral {
    background: rgba(37, 37, 37, 0.07);
    color: var(--color-charcoal);
    border: 1px solid rgba(37, 37, 37, 0.15);
  }

  :global(.dark) .badge-neutral {
    background: rgba(250, 250, 250, 0.07);
    color: var(--color-primary-100);
    border-color: rgba(250, 250, 250, 0.15);
  }

  .badge-accent {
    background: color-mix(in srgb, var(--color-brass) 14%, transparent);
    color: var(--color-brass-ink);
    border: 1px solid
      color-mix(in srgb, var(--color-brass-ink) 30%, transparent);
  }

  :global(.dark) .badge-accent {
    background: color-mix(in srgb, var(--color-brass) 15%, transparent);
    color: var(--color-brass);
    border-color: color-mix(in srgb, var(--color-brass) 35%, transparent);
  }

  @media (max-width: 639px) {
    .row {
      grid-template-columns: auto 1fr;
    }

    .row-main {
      grid-column: 2;
      grid-row: 1;
    }

    .badge {
      grid-column: 2;
      grid-row: 2;
      margin-top: 0.45rem;
    }
  }
</style>
