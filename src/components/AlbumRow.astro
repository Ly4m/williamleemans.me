---
interface Props {
  index: number;
  title: string;
  artist: string;
  note?: string;
  url: string;
  statusLabel: string;
}

const { index, title, artist, note, url, statusLabel } = Astro.props;
const num = String(index + 1).padStart(2, "0");
---

<li class="row">
  <span class="row-index" aria-hidden="true">{num}</span>
  <div class="row-main">
    <a class="row-title" href={url} target="_blank" rel="noopener noreferrer">
      {title}<span class="row-arrow" aria-hidden="true">↗</span>
    </a>
    <p class="row-artist">{artist}</p>
    {note && <p class="row-note">{note}</p>}
  </div>
  <span class="badge register-ident badge-neutral">{statusLabel}</span>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0 0.85rem;
    align-items: start;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(37, 37, 37, 0.12);
  }

  :global(.dark) .row {
    border-bottom-color: rgba(250, 250, 250, 0.1);
  }

  /* A track number is a bar number: notation, and the one place the mono is
     doing exactly the job it was kept for. */
  .row-index {
    font-family: var(--font-notation);
    font-variant-numeric: tabular-nums;
    font-size: 0.75rem;
    color: var(--color-faded);
    padding-top: 0.15rem;
  }

  .row-title {
    font-family: var(--font-voice);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-charcoal);
    text-decoration: none;
  }

  :global(.dark) .row-title {
    color: var(--color-primary-100);
  }

  .row-title:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Snapped to the track-number step rather than keeping its own 0.7rem.
     The old value was the mono-era annotation floor and outlived it: with
     the ramp lifted it was the one size in this file belonging to no step,
     which is a system with a hole in it rather than a considered exception. */
  .row-arrow {
    font-size: 0.75rem;
    color: var(--color-faded);
    margin-left: 0.3rem;
  }

  .row-artist,
  .row-note {
    font-size: 0.875rem;
    color: #555;
    line-height: 1.55;
    margin: 0;
  }

  /* The artist annotates the title, so it takes the expression register; the
     note below it is running text and stays roman. Two lines, two jobs. */
  .row-artist {
    font-style: italic;
    margin-top: 0.15rem;
  }

  .row-note {
    margin-top: 0.3rem;
  }

  :global(.dark) .row-artist,
  :global(.dark) .row-note {
    color: #aaa;
  }

  /* Identification register — same badge as MediaCard, same reasoning. */
  .badge {
    display: inline-block;
    font-size: 0.8125rem;
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
    width: fit-content;
    white-space: nowrap;
    margin-top: 0.15rem;
  }

  /* Neutral only, deliberately. Brass marks the *finished* state (see the
     MediaCard badge), and nothing in a listening list is ever finished.
     "Découverte" wore the brass wash for a while, which made discovery read
     as completion — a second signal on the one wire. If a truly finished
     state ever appears here, it borrows MediaCard's badge-done, not a new
     accent. */
  .badge-neutral {
    background: rgba(37, 37, 37, 0.07);
    color: var(--color-charcoal);
    border: 1px solid rgba(37, 37, 37, 0.15);
  }

  :global(.dark) .badge-neutral {
    background: rgba(250, 250, 250, 0.07);
    color: var(--color-primary-100);
    border-color: rgba(250, 250, 250, 0.15);
  }

  @media (max-width: 639px) {
    .row {
      grid-template-columns: auto 1fr;
    }

    .row-main {
      grid-column: 2;
      grid-row: 1;
    }

    .badge {
      grid-column: 2;
      grid-row: 2;
      margin-top: 0.45rem;
    }
  }
</style>
