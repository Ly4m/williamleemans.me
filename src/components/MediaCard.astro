---
import { Image } from "astro:assets";

interface Props {
  title: string;
  subtitle?: string;
  note?: string;
  status: string;
  statusLabel: string;
  cover?: ImageMetadata;
  type: "book" | "game";
}

const { title, subtitle, note, status, statusLabel, cover, type } = Astro.props;
const isDone = status === "lu" || status === "terminé";

/*
 * `layout="none"` because the card's own CSS owns the geometry — width 100%,
 * a fixed aspect ratio per type, object-fit: cover. Astro's constrained layout
 * would set a competing aspect ratio from the file's intrinsic size.
 *
 * The widths track the grids in NowEntry: books run 2/3/4 across, games 1/2/3.
 */
const sizing =
  type === "game"
    ? {
        widths: [215, 330, 430, 660],
        sizes: "(min-width: 1024px) 215px, (min-width: 640px) 330px, 92vw",
      }
    : {
        widths: [160, 210, 320, 420],
        sizes: "(min-width: 1024px) 160px, (min-width: 768px) 210px, 45vw",
      };
---

<div class="card">
  {
    cover && (
      <div
        class:list={[
          "card-cover",
          type === "game" ? "game-cover" : "book-cover",
        ]}
      >
        {/* Decorative: the title, author and status all sit in the card body
            directly below, so announcing the cover would just repeat them. */}
        <Image
          src={cover}
          alt=""
          layout="none"
          widths={sizing.widths}
          sizes={sizing.sizes}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
  <div class="card-body">
    <span class:list={["badge", isDone ? "badge-done" : "badge-progress"]}>
      {statusLabel}
    </span>
    <p class="card-title">{title}</p>
    {subtitle && <p class="card-subtitle">{subtitle}</p>}
    {note && <p class="card-note">{note}</p>}
  </div>
</div>

<style>
  .card {
    border: 1px solid rgba(37, 37, 37, 0.15);
    border-radius: 3px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: transparent;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
    position: relative;
  }

  :global(.dark) .card {
    border-color: rgba(250, 250, 250, 0.1);
  }

  .card::before,
  .card::after {
    content: "";
    position: absolute;
    width: 6px;
    height: 6px;
    border-color: rgba(37, 37, 37, 0.3);
    border-style: solid;
    pointer-events: none;
    z-index: 1;
  }

  .card::before {
    top: -1px;
    left: -1px;
    border-width: 1px 0 0 1px;
  }

  .card::after {
    bottom: -1px;
    right: -1px;
    border-width: 0 1px 1px 0;
  }

  :global(.dark) .card::before,
  :global(.dark) .card::after {
    border-color: rgba(250, 250, 250, 0.25);
  }

  .card:hover {
    border-color: rgba(37, 37, 37, 0.35);
  }

  :global(.dark) .card:hover {
    border-color: rgba(250, 250, 250, 0.25);
  }

  .book-cover img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    display: block;
  }

  .game-cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 0.65rem 0.75rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
  }

  .badge {
    display: inline-block;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
    margin-bottom: 0.2rem;
    width: fit-content;
    text-transform: uppercase;
  }

  /* Brass marks the finished state; unfinished stays neutral. This badge was
     green, which made it the site's only second accent — and it was carrying
     state, which is brass's whole job.

     The light tint stops at 8%: the label is 11.2px, so it needs 4.5:1, and
     --color-brass-ink over an 8% brass wash on #fafafa lands at 4.51:1. Push
     the wash to 12% and it drops to 4.37 and fails. Dark has room to spare
     (6.3:1 at a 15% wash), so it keeps the fuller tint. */
  .badge-done {
    background: color-mix(in srgb, var(--color-brass) 8%, transparent);
    color: var(--color-brass-ink);
    border: 1px solid
      color-mix(in srgb, var(--color-brass-ink) 30%, transparent);
  }

  :global(.dark) .badge-done {
    background: color-mix(in srgb, var(--color-brass) 15%, transparent);
    color: var(--color-brass);
    border-color: color-mix(in srgb, var(--color-brass) 30%, transparent);
  }

  .badge-progress {
    background: rgba(37, 37, 37, 0.07);
    color: var(--color-charcoal);
    border: 1px solid rgba(37, 37, 37, 0.15);
  }

  :global(.dark) .badge-progress {
    background: rgba(250, 250, 250, 0.07);
    color: var(--color-primary-100);
    border-color: rgba(250, 250, 250, 0.15);
  }

  .card-title {
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-charcoal);
    margin: 0;
  }

  :global(.dark) .card-title {
    color: var(--color-primary-100);
  }

  .card-subtitle {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    color: #555;
    margin: 0;
    margin-top: 0.1rem;
  }

  :global(.dark) .card-subtitle {
    color: #aaa;
  }

  .card-note {
    font-family: "IBM Plex Mono", monospace;
    /* Running text, not a label: multi-line sentences need the 12px reading
       floor; 0.7rem is for the one-line annotation voice (subtitle, badge). */
    font-size: 0.75rem;
    color: #555;
    line-height: 1.5;
    margin: 0;
    margin-top: 0.3rem;
  }

  :global(.dark) .card-note {
    color: #aaa;
  }
</style>
