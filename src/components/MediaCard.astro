---
interface Props {
  title: string;
  subtitle?: string;
  note?: string;
  status: string;
  statusLabel: string;
  coverUrl?: string;
  type: "book" | "game";
}

const { title, subtitle, note, status, statusLabel, coverUrl, type } =
  Astro.props;
const isDone = status === "lu" || status === "terminé";
---

<div class="card">
  {
    coverUrl && (
      <div class:list={["card-cover", type === "game" ? "game-cover" : "book-cover"]}>
        <img src={coverUrl} alt={title} loading="lazy" decoding="async" />
      </div>
    )
  }
  <div class="card-body">
    <span class:list={["badge", isDone ? "badge-done" : "badge-progress"]}>
      {statusLabel}
    </span>
    <p class="card-title">{title}</p>
    {subtitle && <p class="card-subtitle">{subtitle}</p>}
    {note && <p class="card-note">{note}</p>}
  </div>
</div>

<style>
  .card {
    border: 1px solid rgba(37, 37, 37, 0.15);
    border-radius: 3px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: transparent;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
    position: relative;
  }

  :global(.dark) .card {
    border-color: rgba(250, 250, 250, 0.1);
  }

  .card::before,
  .card::after {
    content: "";
    position: absolute;
    width: 6px;
    height: 6px;
    border-color: rgba(37, 37, 37, 0.3);
    border-style: solid;
    pointer-events: none;
    z-index: 1;
  }

  .card::before {
    top: -1px;
    left: -1px;
    border-width: 1px 0 0 1px;
  }

  .card::after {
    bottom: -1px;
    right: -1px;
    border-width: 0 1px 1px 0;
  }

  :global(.dark) .card::before,
  :global(.dark) .card::after {
    border-color: rgba(250, 250, 250, 0.25);
  }

  .card:hover {
    border-color: rgba(37, 37, 37, 0.35);
  }

  :global(.dark) .card:hover {
    border-color: rgba(250, 250, 250, 0.25);
  }

  .book-cover img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    display: block;
  }

  .game-cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 0.65rem 0.75rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
  }

  .badge {
    display: inline-block;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
    margin-bottom: 0.2rem;
    width: fit-content;
    text-transform: uppercase;
  }

  .badge-done {
    background: rgba(34, 120, 60, 0.12);
    color: #22783c;
    border: 1px solid rgba(34, 120, 60, 0.25);
  }

  :global(.dark) .badge-done {
    background: rgba(52, 168, 83, 0.15);
    color: #4ade80;
    border-color: rgba(52, 168, 83, 0.3);
  }

  .badge-progress {
    background: rgba(37, 37, 37, 0.07);
    color: var(--color-charcoal);
    border: 1px solid rgba(37, 37, 37, 0.15);
  }

  :global(.dark) .badge-progress {
    background: rgba(250, 250, 250, 0.07);
    color: var(--color-primary-100);
    border-color: rgba(250, 250, 250, 0.15);
  }

  .card-title {
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-charcoal);
    margin: 0;
  }

  :global(.dark) .card-title {
    color: var(--color-primary-100);
  }

  .card-subtitle {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    color: #555;
    margin: 0;
    margin-top: 0.1rem;
  }

  :global(.dark) .card-subtitle {
    color: #aaa;
  }

  .card-note {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    color: #555;
    line-height: 1.5;
    margin: 0;
    margin-top: 0.3rem;
  }

  :global(.dark) .card-note {
    color: #aaa;
  }
</style>
