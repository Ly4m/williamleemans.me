---
import AnimatedLogo from "./AnimatedLogo.astro";

interface NavItem {
  label: string;
  href: string;
  icon?: string;
}

interface SocialLink {
  label: string;
  href: string;
  icon: string;
  /* A profile is me, somewhere else. The feed and the mailbox aren't — they
     carry no identity to claim, so only profiles get rel="me". */
  profile?: boolean;
}

const { items = [] }: { items?: NavItem[] } = Astro.props;
const current = Astro.url.pathname;

const isActive = (href: string, current: string) => {
  if (href === "/") return current === "/";
  return current === href || current.startsWith(href + "/");
};

/* `label` sert de nom accessible ET d'infobulle. Les deux rendus posent
   `aria-label` en plus de `title` : les liens sont icône-seule, et `title`
   seul n'est pas un nom fiable — il ne s'affiche pas au tactile et les
   lecteurs d'écran ne s'accordent pas sur son annonce. `aria-label` gagne sur
   `title` pour le nom, `title` reste l'infobulle à la souris. Si un libellé
   texte apparaît un jour dans le lien, `aria-label` doit sauter. */
const socialLinks: SocialLink[] = [
  {
    label: "GitHub",
    href: "https://github.com/Ly4m",
    icon: "icon-[tabler--brand-github]",
    profile: true,
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/wleemans",
    icon: "icon-[tabler--brand-linkedin]",
    profile: true,
  },
  {
    label: "Flux RSS",
    href: "/rss.xml",
    icon: "icon-[tabler--rss]",
  },
  {
    label: "M'écrire",
    href: "mailto:william@lmns.fr",
    icon: "icon-[tabler--mail]",
  },
];

/* A new tab is for leaving the site. The feed is part of it, and a mail client
   isn't a tab at all — both stay in place. */
const opensInNewTab = (href: string) => href.startsWith("http");

/* Le nom du repère de navigation. Les deux rendus le portent : un seul est
   dans l'arbre d'accessibilité à la fois (le rail est en `display:none` sous
   md, le menu mobile est `inert` tant qu'il est fermé), donc les deux ne se
   confondent jamais. Si un jour les deux sont exposés ensemble, il leur faut
   deux noms distincts. */
const NAV_LABEL = "Navigation principale";

/* Une nouvelle fenêtre s'annonce : l'icône seule ne dit pas qu'on quitte le
   site, et le changement de contexte arrive sans prévenir au lecteur d'écran.
   Le suffixe va sur `aria-label` (le nom), pas sur `title` (l'infobulle
   souris), qui n'a pas besoin de le répéter à qui voit déjà l'onglet s'ouvrir. */
const nameFor = (s: SocialLink) =>
  opensInNewTab(s.href) ? `${s.label} (nouvelle fenêtre)` : s.label;

/* Both renders below draw their rel from here, so the two can't drift. */
const relFor = (s: SocialLink) => {
  const tokens = [
    s.profile && "me",
    opensInNewTab(s.href) && "noopener noreferrer",
  ].filter(Boolean);
  return tokens.length ? tokens.join(" ") : undefined;
};
---

<header
  class="fixed inset-x-0 top-0 z-50 flex h-14 items-center justify-between bg-(--color-page) px-4 md:hidden"
>
  <AnimatedLogo />

  <button
    id="mobile-menu-toggle"
    class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 rounded-md text-gray-600 hover:bg-gray-100 hover:text-black dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
    aria-label="Ouvrir le menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span
      class="hamburger-line h-0.5 w-5 bg-current transition-[transform,opacity] duration-300"
    ></span>
    <span
      class="hamburger-line h-0.5 w-5 bg-current transition-[transform,opacity] duration-300"
    ></span>
    <span
      class="hamburger-line h-0.5 w-5 bg-current transition-[transform,opacity] duration-300"
    ></span>
  </button>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-40 flex translate-x-full flex-col items-center justify-center bg-(--color-page) transition-transform duration-300 md:hidden"
  inert
>
  <nav class="flex flex-col items-center gap-8" aria-label={NAV_LABEL}>
    {
      items.map(({ label, href, icon }) => {
        const active = isActive(href, current);
        return (
          <a
            href={href}
            data-active={active ? "true" : undefined}
            aria-current={active ? "page" : undefined}
            class={[
              "mobile-menu-link register-ident flex flex-col items-center gap-2 text-2xl transition-all duration-200",
              active
                ? "text-black dark:text-white"
                : "text-gray-600 hover:text-black dark:text-gray-400 dark:hover:text-white",
            ].join(" ")}
          >
            {icon && <i class={`${icon} text-3xl`} />}
            <span class="mobile-nav-label relative inline-block">{label}</span>
          </a>
        );
      })
    }
  </nav>

  <div class="absolute bottom-12 flex gap-4">
    {
      socialLinks.map((s) => (
        <a
          href={s.href}
          rel={relFor(s)}
          target={opensInNewTab(s.href) ? "_blank" : undefined}
          class="flex h-12 w-12 items-center justify-center rounded-md text-gray-600 transition hover:bg-gray-100 hover:text-black dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
          aria-label={nameFor(s)}
          title={s.label}
        >
          <i class={["text-2xl", s.icon].join(" ")} aria-hidden="true" />
        </a>
      ))
    }
    <button
      data-theme-toggle
      aria-label="Changer de thème"
      class="flex h-12 w-12 items-center justify-center rounded-md text-gray-600 transition hover:bg-gray-100 hover:text-black dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
    >
      <i data-theme-icon class="icon-[tabler--sun] text-2xl" aria-hidden="true"
      ></i>
    </button>
  </div>
</div>

<aside
  class="text-charcoal dark:text-primary-100 sticky top-0 z-40 hidden h-screen w-24 pt-24 md:block lg:block"
>
  <nav class="space-y-2 py-6 pl-6" aria-label={NAV_LABEL}>
    {
      items.map(({ label, href }) => {
        const active = isActive(href, current);
        return (
          <a
            href={href}
            data-active={active ? "true" : undefined}
            aria-current={active ? "page" : undefined}
            class={[
              "nav-link register-ident group relative block px-3 py-2 text-sm transition",
              active ? "" : "opacity-70 hover:opacity-100",
            ].join(" ")}
          >
            <span class="inline-block translate-x-0 transition group-hover:translate-x-1">
              {label}
            </span>
          </a>
        );
      })
    }
  </nav>

  {
    /* Oui, l'accueil redit GitHub, LinkedIn et l'e-mail dans ses lignes de
       contact — et le rail les garde quand même. Ailleurs (blog, talks, now)
       le rail est le seul accès : les retirer ici les retirerait partout, et
       n'en faire un cas particulier que sur l'accueil ferait clignoter un
       chrome persistant d'une page à l'autre. Le coût, quatre tabulations
       redondantes, ne se paie que si l'on refuse le lien d'évitement, qui est
       premier dans l'ordre du clavier et saute tout le rail. Réexaminé le
       2026-08-11 ; à rouvrir seulement si le rail cesse d'être le seul accès
       hors accueil. */
  }
  <div class="absolute bottom-6 flex gap-2 pl-6">
    {
      socialLinks.map((s) => (
        <a
          href={s.href}
          rel={relFor(s)}
          target={opensInNewTab(s.href) ? "_blank" : undefined}
          class="flex h-8 w-8 items-center justify-center rounded-md text-gray-600 hover:bg-gray-100 hover:text-black dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
          aria-label={nameFor(s)}
          title={s.label}
        >
          <i class={["text-lg", s.icon].join(" ")} aria-hidden="true" />
        </a>
      ))
    }
    <button
      data-theme-toggle
      aria-label="Changer de thème"
      class="flex h-8 w-8 items-center justify-center rounded-md text-gray-600 hover:bg-gray-100 hover:text-black dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
    >
      <i data-theme-icon class="icon-[tabler--sun] text-lg" aria-hidden="true"
      ></i>
    </button>
  </div>
</aside>

<style>
  /* The active rail. Hover and active differ by length, not opacity — a stub
     that grows to full height — so the two states stay tellable apart at a
     glance in either theme. */
  .nav-link::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3px;
    background: var(--color-brass-ink);
    transform: scaleY(0);
    transition: transform 0.25s ease;
  }

  .nav-link:not([data-active]):hover::before {
    transform: scaleY(0.4);
  }

  /* The register's weight is 500; the rail buys its active step by dropping
     inactive items back to 400. It has to be declared here rather than with a
     `font-normal` utility: `.register-ident` is unlayered and beats any
     Tailwind layer, so the utility silently lost and every item sat at 500. */
  .nav-link:not([data-active]) {
    font-weight: 400;
  }

  .nav-link[data-active]::before {
    transform: scaleY(1);
    /* Lets the rail slide between items across a navigation. Only one item is
       active per page, so the name is never duplicated; the mobile menu is
       display:none at this breakpoint and can't collide with it. */
    view-transition-name: nav-rail;
  }

  /* Same rail, laid on its side. No hover half-state — this menu is touch-only. */
  .mobile-nav-label::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -0.4rem;
    left: 0;
    height: 3px;
    background: var(--color-brass-ink);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }

  [data-active] .mobile-nav-label::after {
    transform: scaleX(1);
  }

  /* Full-strength brass is the loudest thing on a dark page — every other brass
     element sits at 28-35%. Knocking it back toward the page colour lands at
     4.3:1, comfortably above the 3:1 a state indicator needs, without the glare.
     Light mode keeps the full --color-brass-ink; it doesn't have this problem. */
  :global(.dark) .nav-link::before,
  :global(.dark) .mobile-nav-label::after {
    background: color-mix(in srgb, var(--color-brass) 65%, var(--color-page));
  }

  /* The rail's length carries information, so it stays; only the travel goes. */
  @media (prefers-reduced-motion: reduce) {
    .nav-link::before,
    .mobile-nav-label::after {
      transition: none;
    }
  }

  /* `.menu-open` lives on <body>, which the layout renders — so it never carries
     this component's scope attribute. Written bare, Astro scoped all three rules
     to a selector that could never match and the burger silently stayed a burger
     with the menu open. `:global()` on that one part is what makes the X appear;
     the rest stays scoped. Falsifier: open the menu and read the computed
     transform of `.hamburger-line` — `none` means this regressed. */
  :global(.menu-open) #mobile-menu-toggle .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(6px, 6px);
  }

  :global(.menu-open) #mobile-menu-toggle .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  :global(.menu-open) #mobile-menu-toggle .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(6px, -6px);
  }

  /* The X carries the state, so it stays; only the travel goes. */
  @media (prefers-reduced-motion: reduce) {
    .hamburger-line {
      transition: none;
    }
  }
</style>

<script>
  import { syncThemeColor } from "../lib/theme-color";

  function initThemeToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(
      "[data-theme-toggle]",
    );

    function updateToggles() {
      const isDark = document.documentElement.classList.contains("dark");
      document
        .querySelectorAll<HTMLElement>("[data-theme-icon]")
        .forEach((icon) => {
          /* classList, pas className : les deux rendus portent des tailles
             différentes (text-lg au rail, text-2xl au menu) qu'une réécriture
             complète écrasait. */
          icon.classList.toggle("icon-[tabler--moon]", isDark);
          icon.classList.toggle("icon-[tabler--sun]", !isDark);
        });
      /* Le libellé porte l'état : l'icône seule change en silence pour un
         lecteur d'écran, et « Changer de thème » ne disait pas où l'on est.
         Le libellé statique du HTML reste le repli sans JS. */
      const label = isDark ? "Passer au thème clair" : "Passer au thème sombre";
      buttons.forEach((btn) => {
        btn.setAttribute("aria-label", label);
        btn.setAttribute("title", label);
      });
    }

    /* L'appel de courant : la bascule ne clignote pas. La nouvelle feuille est
       révélée par un front qui part du bouton lui-même — dernier élément du
       rail, en bas à gauche — et traverse la page en diagonale vers le haut à
       droite. Le courant part de l'interrupteur qu'on vient de fermer ; c'est
       le geste, pas un effet posé par-dessus.

       Un front rectiligne à 45° traversant d'un coin à l'autre a été essayé, et
       écarté par le propriétaire (2026-08-13) : géométriquement plus lisible,
       mais il perd l'origine, et c'est l'origine qui raconte quelque chose. La
       version au bouton est la bonne — ne pas la « corriger » vers la
       diagonale une seconde fois.

       Le dégagement CSS est dans global.css, sous `.theme-wipe`. Ici on ne
       calcule que ce que lui ne peut pas savoir : où est le bouton, et jusqu'où
       le front doit aller. */
    const WIPE_MS = 600;

    function toggleTheme(event: Event) {
      const root = document.documentElement;
      const isDark = root.classList.contains("dark");

      const apply = () => {
        root.classList.toggle("dark", !isDark);
        localStorage.setItem("theme", isDark ? "light" : "dark");
        updateToggles();
      };

      /* Repli sec — exactement l'ancien comportement — partout où le geste n'a
         pas lieu d'être : mouvement réduit, navigateur sans l'API, ou un appel
         qui ne vient pas d'un bouton (donc sans origine à donner au front). */
      const btn = event.currentTarget as HTMLElement | null;
      if (
        !btn ||
        !document.startViewTransition ||
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        apply();
        syncThemeColor();
        return;
      }

      const w = window.innerWidth;
      const h = window.innerHeight;
      const box = btn.getBoundingClientRect();
      const x = box.left + box.width / 2;
      const y = box.top + box.height / 2;
      // Le front doit atteindre le coin le plus éloigné de l'interrupteur.
      const reach = Math.hypot(Math.max(x, w - x), Math.max(y, h - y));

      /* TOUT EN POURCENTAGES, ET C'EST LA CORRECTION D'UN VRAI BUG.

         `::view-transition-new(root)` n'est pas garanti d'être à l'échelle du
         pixel CSS : selon le zoom du navigateur et l'échelle de l'écran, sa
         boîte vit dans un espace plus grand. Écrit en `px`, le centre partait
         alors à une fraction de sa position — le cercle naissait au milieu du
         bord gauche au lieu du bouton, ce qui a été vu et signalé, et ce que
         cette machine (à 1:1) ne reproduit jamais.

         Les pourcentages, eux, se résolvent contre cette boîte quelle qu'en
         soit l'échelle, donc le centre atterrit au bon endroit partout. Le
         rayon en % a sa propre référence, `√(w²+h²)/√2` — d'où la conversion
         plutôt qu'un 150% fourre-tout, qui ferait grandir le cercle au-delà de
         l'écran pendant une partie de l'animation.

         Ne pas repasser en `px` : ça marchera sur la machine où c'est réécrit. */
      const pctRef = Math.hypot(w, h) / Math.SQRT2;
      const at = `${((x / w) * 100).toFixed(3)}% ${((y / h) * 100).toFixed(3)}%`;
      const reachPct = ((reach / pctRef) * 100).toFixed(3);

      root.classList.add("theme-wipe");
      const transition = document.startViewTransition(apply);

      transition.ready.then(
        () => {
          root.animate(
            {
              clipPath: [
                `circle(0% at ${at})`,
                `circle(${reachPct}% at ${at})`,
              ],
            },
            {
              duration: WIPE_MS,
              /* La courbe avec laquelle les traces se dessinent déjà
                 (`circuit-draw`) : un seul tracé sur tout le site. */
              easing: "cubic-bezier(0.4, 0, 0.2, 1)",
              pseudoElement: "::view-transition-new(root)",
            },
          );
        },
        /* `ready` REJETTE quand la transition est abandonnée, et ça arrive pour
           de vrai : onglet quitté pendant la bascule, fenêtre entièrement
           masquée (le navigateur refuse alors la transition), ou une seconde
           bascule par-dessus la première. Le thème est déjà appliqué dans tous
           ces cas — le callback a tourné — et `finished` nettoie la classe.
           Il n'y a donc rien à réparer ici, seulement un rejet à absorber :
           sans ce bras, chaque abandon écrivait une unhandled rejection dans
           la console pour un geste qui, lui, s'est bien passé. */
        () => {},
      );

      /* La barre du navigateur mobile suit la feuille au lieu de la précéder :
         elle vit hors du wipe, donc la changer tout de suite afficherait la
         couleur d'arrivée au-dessus d'une page encore à moitié partie. */
      transition.finished.finally(() => {
        root.classList.remove("theme-wipe");
        syncThemeColor();
      });
    }

    buttons.forEach((btn) => btn.addEventListener("click", toggleTheme));
    updateToggles();

    return () =>
      buttons.forEach((btn) => btn.removeEventListener("click", toggleTheme));
  }

  function initMobileMenu() {
    const toggleEl = document.getElementById("mobile-menu-toggle");
    const menuEl = document.getElementById("mobile-menu");
    const menuLinks = document.querySelectorAll(".mobile-menu-link");

    if (!toggleEl || !menuEl) return;

    // Re-bound after the guard: the handlers below are hoisted declarations, so
    // TypeScript won't carry the narrowing into them from the originals.
    const toggle = toggleEl;
    const menu = menuEl;

    /* The closed menu is still on the page, parked off-screen. `inert` is what
       takes it out of the tab order and the accessibility tree at once —
       `aria-hidden` alone claimed it was gone while its links stayed
       focusable. */
    /* Le libellé porte l'état en plus d'`aria-expanded`, comme le bouton de
       thème : le bouton ouvert est aussi le seul moyen de refermer, et « Ouvrir
       le menu » sur le bouton qui ferme envoyait dans le mauvais sens. Le
       libellé statique du HTML reste le repli sans JS. */
    function closeMenu() {
      // Focus can't stay inside an inert subtree; hand it back to the toggle.
      const hadFocus = menu.contains(document.activeElement);
      menu.classList.add("translate-x-full");
      menu.inert = true;
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Ouvrir le menu");
      document.body.classList.remove("menu-open");
      document.body.style.overflow = "";
      if (hadFocus) toggle.focus();
    }

    function openMenu() {
      menu.classList.remove("translate-x-full");
      menu.inert = false;
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Fermer le menu");
      document.body.classList.add("menu-open");
      document.body.style.overflow = "hidden";
    }

    function toggleMenu() {
      menu.inert ? openMenu() : closeMenu();
    }

    function handleEscape(e: KeyboardEvent) {
      if (e.key === "Escape" && !menu.inert) closeMenu();
    }

    toggle.removeEventListener("click", toggleMenu);
    toggle.addEventListener("click", toggleMenu);

    menuLinks.forEach((link) => {
      link.removeEventListener("click", closeMenu);
      link.addEventListener("click", closeMenu);
    });

    document.removeEventListener("keydown", handleEscape);
    document.addEventListener("keydown", handleEscape);

    return () => {
      toggle.removeEventListener("click", toggleMenu);
      menuLinks.forEach((link) => link.removeEventListener("click", closeMenu));
      document.removeEventListener("keydown", handleEscape);
    };
  }

  let cleanupMenu = initMobileMenu();
  let cleanupTheme = initThemeToggle();

  document.addEventListener("astro:page-load", () => {
    if (cleanupMenu) cleanupMenu();
    if (cleanupTheme) cleanupTheme();
    cleanupMenu = initMobileMenu();
    cleanupTheme = initThemeToggle();
  });

  document.addEventListener("astro:before-preparation", () => {
    if (cleanupMenu) cleanupMenu();
    if (cleanupTheme) cleanupTheme();
  });
</script>
