---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import MediaCard from "./MediaCard.astro";
import AlbumRow from "./AlbumRow.astro";
import { coverSlug } from "../lib/covers.mjs";

interface Props {
  entry: CollectionEntry<"now">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const books = entry.data.books ?? [];
const games = entry.data.games ?? [];
const music = entry.data.music ?? [];

/*
 * Covers come from the repo, matched by convention on the slug — see
 * src/lib/covers.mjs. This used to be two `fetch` calls to openlibrary.org and
 * rawg.io per entry, at build time: ~17 seconds of a 21-second build, and a
 * silent blank card whenever an upstream was slow or the API key was missing.
 * `pnpm covers` now does that lookup once, at authoring time.
 *
 * A title with no file on disk still renders — it just has no cover.
 */
const covers = import.meta.glob<{ default: ImageMetadata }>(
  "../content/now/covers/*.jpg",
  { eager: true },
);

const coverFor = (title: string, author?: string) =>
  covers[`../content/now/covers/${coverSlug(title, author)}.jpg`]?.default;
---

<article class="prose dark:prose-invert wave-enter-content mb-12">
  <Content />
</article>

{
  books.length > 0 && (
    <section class="mb-12">
      <h3 class="font-voice text-charcoal dark:text-primary-100 mb-4 text-2xl font-bold">
        Lecture
      </h3>
      {entry.data.booksIntro && (
        <p class="text-charcoal dark:text-primary-100 font-voice mb-4 max-w-[55ch] text-lg opacity-80">
          {entry.data.booksIntro}
        </p>
      )}
      <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">
        {books.map((book) => (
          <MediaCard
            title={book.title}
            subtitle={book.author}
            note={book.note}
            status={book.status}
            statusLabel={book.status === "en-cours" ? "▶ En cours" : "✓ Lu"}
            cover={coverFor(book.title, book.author)}
            type="book"
          />
        ))}
      </div>
    </section>
  )
}

{
  games.length > 0 && (
    <section class="mb-12">
      <h3 class="font-voice text-charcoal dark:text-primary-100 mb-4 text-2xl font-bold">
        Gaming
      </h3>
      {entry.data.gamesIntro && (
        <p class="text-charcoal dark:text-primary-100 font-voice mb-4 max-w-[55ch] text-lg opacity-80">
          {entry.data.gamesIntro}
        </p>
      )}
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {games.map((game) => (
          <MediaCard
            title={game.title}
            note={game.note}
            status={game.status}
            statusLabel={
              game.status === "en-cours" ? "▶ En cours" : "✓ Terminé"
            }
            cover={coverFor(game.title)}
            type="game"
          />
        ))}
      </div>
    </section>
  )
}

{
  music.length > 0 && (
    <section class="mb-12">
      <h3 class="font-voice text-charcoal dark:text-primary-100 mb-4 text-2xl font-bold">
        En écoute
      </h3>
      {entry.data.musicIntro && (
        <p class="text-charcoal dark:text-primary-100 font-voice mb-4 max-w-[55ch] text-lg opacity-80">
          {entry.data.musicIntro}
        </p>
      )}
      <ol class="album-list">
        {music.map((album, i) => (
          <AlbumRow
            index={i}
            title={album.title}
            artist={album.artist}
            note={album.note}
            url={album.url}
            statusLabel={
              album.status === "découverte" ? "✦ Découverte" : "↻ En boucle"
            }
          />
        ))}
      </ol>
    </section>
  )
}

<style>
  .album-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(37, 37, 37, 0.12);
  }

  :global(.dark) .album-list {
    border-top-color: rgba(250, 250, 250, 0.1);
  }
</style>
